      <column caption='Female Deaths' datatype='string' name='[Calculation_285134194743545858]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(SUM(IF [Gender] = &quot;Female&quot; THEN [Number_of_Deaths] END) / 1000000, 1)) + &quot;M&quot;' />
      </column>
      <column caption='Male Deaths' datatype='string' name='[Calculation_285134194744381443]' role='measure' type='nominal'>
