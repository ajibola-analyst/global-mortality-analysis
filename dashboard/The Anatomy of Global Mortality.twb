      </column>
      <column caption='Male Deathhhs' datatype='integer' name='[Calculation_285134194749792262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Gender] = &apos;Male&apos; THEN -[Number_of_Deaths] ELSE 0 END' />
      </column>
